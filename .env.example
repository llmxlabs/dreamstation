# DreamStation uses SQLite and local media storage. Keep this file private.
DATABASE_URL="file:./prisma/dev.db"
# Optional LAN URL for pairing QR codes. Set before npm run build.
# NEXT_PUBLIC_APP_URL="http://192.168.1.100:3000"
# Optional URL importer settings; the browser must run on this same server.
# DREAMSTATION_BROWSER_URL="http://127.0.0.1:9222"
# DREAMSTATION_STATE_DIR="/path/to/private/dreamstation-state"
